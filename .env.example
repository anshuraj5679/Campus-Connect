# ---- Supabase (Project Settings → API) ----
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# The anon key, or the newer "publishable" key (sb_publishable_...)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key
# Server-only. Used by server actions, seed and migration scripts. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Direct Postgres URL for `npm run db:migrate` / `npm run seed` (session pooler, port 5432).
# URL-encode special characters in the password (@ → %40).
SUPABASE_DB_URL=postgresql://postgres.your-ref:YOUR_PASSWORD@aws-0-region.pooler.supabase.com:5432/postgres

# ---- Demo mode (one-click demo logins + "Simulate time") ----
NEXT_PUBLIC_DEMO_MODE=true
DEMO_PASSWORD=Demo@12345

# ---- Scheduled jobs (SLA auto-escalation, auto-close) ----
CRON_SECRET=generate-a-long-random-string

# ---- Institution display ----
NEXT_PUBLIC_COLLEGE_NAME=BMS Institute of Technology and Management
NEXT_PUBLIC_COLLEGE_SHORT_NAME=BMSIT&M
NEXT_PUBLIC_ACADEMIC_YEAR_LABEL=AY 2026–27 · Odd Sem
